{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "할 일",
        "알아 둘 것",
        "없음"
      ]
    },
    "title": {
      "type": "string"
    },
    "dates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string"
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "appliesTo": {
            "type": ["string", "null"],
            "description": "행동할 일부 사람이나 조건을 달력 맨 앞에 붙일 짧은 말로 쓴다(벽걸이형 반만, 개방 당번, 복귀 차량 반만). 조건이 달라질 정도로 줄이지 않는다. 제한이 없거나 행사·시설 정보면 null."
          },
          "label": {
            "type": "string",
            "description": "자세히 볼 그날의 행동. 정확한 지점·목적지와 목적물, 장소가 바뀌면 새 장소를 남긴다. appliesTo는 앱이 앞에 붙인다."
          },
          "shortLabel": {
            "type": ["string", "null"],
            "description": "좁은 월 달력용 핵심 대상과 행동(고정 나사 수령, 마이크 수량 회신). 장소 변경이면 새 장소를 담는다(예: 공연장 → 강당). label이 이미 간단하면 null. appliesTo는 앱이 앞에 붙인다."
          },
          "shortScope": {
            "type": ["string", "null"],
            "description": "appliesTo가 장문일 때만, 같은 대상을 빠짐없이 가리키는 월 달력용 짧은 명사구(예: 벽걸이형 반만, 노란 표식 모둠만). 짧은 표현으로 구분하기 어렵거나 이미 간단하거나 대상 제한이 없으면 null."
          },
          "kind": {
            "type": "string",
            "enum": [
              "까지",
              "그날",
              "기간"
            ]
          }
        },
        "required": [
          "date",
          "end",
          "appliesTo",
          "label",
          "shortLabel",
          "shortScope",
          "kind"
        ]
      }
    },
    "uncertain": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part": { "type": "integer" },
          "quote": { "type": "string" }
        },
        "required": ["part", "quote"]
      }
    }
  },
  "required": [
    "type",
    "title",
    "dates",
    "uncertain",
    "evidence"
  ]
}
